module markd/entities_test

import markd/h_t_m_l_entities::{decode_entity, decode_entities}

assert decode_entity("amp") == "&"
assert decode_entity("NotEqualTilde") == "≂̸"
assert decode_entity("ThisIsNotDefined") == "&ThisIsNotDefined;"
assert decode_entity("#35") == "#"
assert decode_entity("#x80") == "€"
assert decode_entity("#0") == "�"
assert decode_entities("Fish &amp; Chips") == "Fish & Chips"
assert decode_entities("plain") == "plain"
assert decode_entities("&MadeUpEntity;") == "&MadeUpEntity;"
